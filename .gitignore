# ── Python ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*.so
*.egg-info/
.eggs/
build/
dist/

# ── Virtual environments ───────────────────────────────
.venv/
venv/
env/

# ── Secrets / environment ─────────────────────────────
.env
.env.*
.python-version

# ── Data (raw downloads & derived datasets are large) ─
data/raw/
data/build/
data/staging/
data/processed/
data/interim/
*.mmap
*.parquet
*.npy
*.npz
*.zarr

# ── Download / build temp files ────────────────────────
*.part
*.aria2
*.incomplete
*.tmp
*.download

# ── Model artifacts / checkpoints ─────────────────────
checkpoints/*
!checkpoints/.gitkeep
*.pt
*.pth
*.ckpt
*.bin
*.safetensors
*.onnx
*.engine

# ── Hugging Face caches (keep model weights out of git) ─
.hf/
hf_cache/
hf_home/
*.hf

# ── Runtime outputs ───────────────────────────────────
outputs/*
!outputs/.gitkeep
*.log
logs/

# ── Test / lint caches ────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── IDE / OS ──────────────────────────────────────────
.idea/
.vscode/
.DS_Store
Thumbs.db
.ipynb_checkpoints/
.cache/
.tools/
